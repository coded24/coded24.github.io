---
import BaseLayout from '../layouts/BaseLayout.astro';
import { additionalProjects, featuredProjects, recentProjects } from '../content/projects';
import { skills, site, specialties } from '../content/site';
import githubRepos from '../content/github-repos.json';

type GitHubRepository = {
  name: string;
  html_url: string;
  description: string | null;
  language: string | null;
  stargazers_count: number;
  updated_at: string;
};

const repositories = (githubRepos as GitHubRepository[])
  .filter((repo) => repo && typeof repo.name === 'string')
  .slice(0, 6);
const publishedRecentProjects = recentProjects
  .filter((project) => project.published && project.date && project.description)
  .sort((left, right) => right.date.localeCompare(left.date));
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  email: site.email,
  address: { '@type': 'PostalAddress', addressCountry: 'GH' },
  sameAs: [site.github, site.linkedin],
};
---

<BaseLayout>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <div class="site-shell">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="topbar">
      <a class="wordmark" href="#top" aria-label={`${site.name}, home`}>
        <span class="wordmark-mark" aria-hidden="true">CA</span>
        <span>{site.name}</span>
      </a>
      <nav class="main-nav" aria-label="Main navigation">
        <a href="#work">Work</a>
        <a href="#about">About</a>
        <a class="nav-github" href={site.github} target="_blank" rel="noreferrer">GitHub</a>
        <a class="nav-contact" href={`mailto:${site.email}`}>Contact <span aria-hidden="true">↗</span></a>
        <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch to dark theme" title="Switch theme"><span aria-hidden="true">◐</span></button>
      </nav>
    </header>

    <main id="main-content">
      <div id="top"></div>
      <section class="hero section-wrap" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow"><span class="status-dot"></span> AVAILABLE FOR REMOTE WORK <span class="eyebrow-divider">/</span> GMT</p>
          <h1 id="hero-title">Backend systems<br />built to <em>run reliably.</em></h1>
          <p class="hero-summary">{site.description}</p>
          <div class="hero-actions">
            <a class="button button-dark" href="#work">Explore selected work <span aria-hidden="true">↓</span></a>
            <a class="text-link" href={`mailto:${site.email}`}>Get in touch <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <aside class="hero-aside" aria-label="Professional overview">
          <div class="aside-topline"><span>PROFILE / 01</span><span>GH · GMT</span></div>
          <div class="aside-monogram" aria-hidden="true">C<span>.</span>A</div>
          <p class="aside-role">Backend Developer<br />Linux Systems Administrator</p>
          <div class="aside-rule"></div>
          <dl class="aside-facts">
            <div><dt>FOCUS</dt><dd>Automation, data & infrastructure</dd></div>
            <div><dt>LOCATION</dt><dd>{site.location}</dd></div>
            <div><dt>AVAILABILITY</dt><dd>Remote · Full-time · Contract</dd></div>
          </dl>
          <a class="aside-link" href={site.github} target="_blank" rel="noreferrer">GITHUB PROFILE <span aria-hidden="true">↗</span></a>
        </aside>
        <div class="hero-index" aria-hidden="true"><span>PORTFOLIO</span><span>2026</span><span>01 — 05</span></div>
      </section>

      <section class="proof-strip" aria-label="Areas of expertise">
        <div class="section-wrap proof-inner">
          <span class="proof-label">WORKING ACROSS</span>
          {specialties.map((specialty) => <span class="proof-item">{specialty}</span>)}
        </div>
      </section>

      <section class="work-section section-wrap" id="work" aria-labelledby="work-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">01 / SELECTED WORK</p>
            <h2 id="work-title">Built for the real world.</h2>
          </div>
          <p class="section-note">Systems, services, and tools made to do useful work beyond the demo.</p>
        </div>

        <div class="project-list">
          {featuredProjects.map((project, index) => (
            <article class="project-row">
              <div class="project-number">0{index + 1}</div>
              <div class="project-main">
                <p class="project-category">{project.category}</p>
                <h3>{project.title}</h3>
                <p class="project-context"><span>CONTEXT</span> {project.context}</p>
                <p class="project-summary">{project.summary}</p>
                <ul class="project-details">
                  {project.details.map((detail) => <li>{detail}</li>)}
                </ul>
              </div>
              <aside class="project-meta">
                <div>
                  <p class="meta-label">CONTRIBUTION</p>
                  <p class="meta-value">{project.role}</p>
                </div>
                <div>
                  <p class="meta-label">RESULT</p>
                  <p class="meta-value">{project.result}</p>
                </div>
                <div>
                  <p class="meta-label">TECHNOLOGY</p>
                  <ul class="tag-list">
                    {project.stack.map((item) => <li>{item}</li>)}
                  </ul>
                </div>
                {(project.repo || project.live) && (
                  <div class="project-links">
                    {project.live && <a href={project.live} target="_blank" rel="noreferrer">Live project ↗</a>}
                    {project.repo && <a href={project.repo} target="_blank" rel="noreferrer">Source code ↗</a>}
                  </div>
                )}
              </aside>
            </article>
          ))}
        </div>

        <div class="additional-work">
          <p class="eyebrow">ALSO IN THE WORKSHOP</p>
          {additionalProjects.map((project) => (
            <article class="additional-row">
              <div><h3>{project.title}</h3><p>{project.summary}</p></div>
              <span>{project.category}</span>
            </article>
          ))}
        </div>
      </section>

      <section class="recent-section" aria-labelledby="recent-title">
        <div class="section-wrap recent-inner">
          <div class="section-heading">
            <div>
              <p class="eyebrow">02 / IN PROGRESS</p>
              <h2 id="recent-title">Recent projects.</h2>
            </div>
            <p class="section-note">New work will appear here as details are ready to share.</p>
          </div>
          {publishedRecentProjects.length > 0 ? (
            <div class="recent-list">
              {publishedRecentProjects.map((project) => (
                <article class="recent-project">
                  <time datetime={project.date}>{new Date(`${project.date}T00:00:00Z`).toLocaleDateString('en', { month: 'short', year: 'numeric', timeZone: 'UTC' })}</time>
                  <div>
                    <h3>{project.title}</h3>
                    <p>{project.description}</p>
                    {project.image && <img class="recent-image" src={project.image} alt={project.imageAlt || ''} width="720" height="405" loading="lazy" decoding="async" />}
                    <ul class="tag-list">{project.tags.map((tag) => <li>{tag}</li>)}</ul>
                  </div>
                  <div class="recent-links">{project.live && <a href={project.live} target="_blank" rel="noreferrer">Live ↗</a>}{project.repo && <a href={project.repo} target="_blank" rel="noreferrer">Code ↗</a>}</div>
                </article>
              ))}
            </div>
          ) : (
            <div class="empty-recent">
              <span class="empty-marker" aria-hidden="true">+</span>
              <p>More project details coming soon.</p>
              <span class="mono-note">UPDATED AS WORK SHIPS</span>
            </div>
          )}
        </div>
      </section>

      <section class="github-section section-wrap" id="github" aria-labelledby="github-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">03 / OPEN SOURCE ACTIVITY</p>
            <h2 id="github-title">From GitHub<span class="title-period">.</span></h2>
          </div>
          <a class="text-link" href={site.github} target="_blank" rel="noreferrer">View all repositories <span aria-hidden="true">↗</span></a>
        </div>
        {repositories.length > 0 ? (
          <div class="repo-grid">
            {repositories.map((repo) => (
              <a class="repo-item" href={repo.html_url} target="_blank" rel="noreferrer">
                <div class="repo-top"><span class="repo-icon" aria-hidden="true">GH</span><span class="repo-arrow" aria-hidden="true">↗</span></div>
                <h3>{repo.name}</h3>
                <p>{repo.description || 'No description provided.'}</p>
                <div class="repo-meta">
                  {repo.language && <span><i class="language-dot"></i>{repo.language}</span>}
                  <span>★ {repo.stargazers_count ?? 0}</span>
                  <time datetime={repo.updated_at}>{new Date(repo.updated_at).toLocaleDateString('en', { month: 'short', year: 'numeric' })}</time>
                </div>
              </a>
            ))}
          </div>
        ) : (
          <div class="github-empty">
            <span class="github-empty-mark" aria-hidden="true">GH</span>
            <div><h3>Browse my code on GitHub.</h3><p>No public repositories are available to feature right now.</p></div>
            <a class="button button-outline" href={site.github} target="_blank" rel="noreferrer">Visit GitHub <span aria-hidden="true">↗</span></a>
          </div>
        )}
      </section>

      <section class="about-section" id="about" aria-labelledby="about-title">
        <div class="section-wrap about-inner">
          <div class="about-intro">
            <p class="eyebrow">04 / A LITTLE ABOUT ME</p>
            <h2 id="about-title">Practical software.<br /><em>Thoughtful operations.</em></h2>
            <p>Backend developer and Linux systems administrator based in Ghana. I build automated data pipelines, web applications, and self-hosted infrastructure, with an emphasis on services that keep working without constant manual attention.</p>
            <p>I’m currently a student at Ho Technical University and open to remote work across GMT, UK, and European business hours.</p>
            <a class="text-link" href="/cv">View / print my CV <span aria-hidden="true">↗</span></a>
          </div>
          <div class="skills-panel">
            <p class="eyebrow">TOOLS I WORK WITH</p>
            {Object.entries(skills).map(([group, items]) => (
              <div class="skill-group"><h3>{group}</h3><ul>{items.map((item) => <li>{item}</li>)}</ul></div>
            ))}
          </div>
        </div>
      </section>

      <section class="contact-section section-wrap" id="contact" aria-labelledby="contact-title">
        <div>
          <p class="eyebrow">05 / CONTACT</p>
          <h2 id="contact-title">Have a system<br />to make <em>work better?</em></h2>
        </div>
        <div class="contact-actions">
          <a class="button button-dark" href={`mailto:${site.email}`}>Email Christopher <span aria-hidden="true">↗</span></a>
          <a class="contact-social" href={site.linkedin} target="_blank" rel="noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
          <a class="contact-social" href={site.github} target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
          <p>{site.availability}. Full overlap with UK and European business hours.</p>
        </div>
      </section>
    </main>

    <footer class="footer section-wrap">
      <a class="footer-name" href="#top">{site.name}<span>.</span></a>
      <span>Backend development · Linux systems · Ghana</span>
      <div><a href={site.github} target="_blank" rel="noreferrer">GitHub ↗</a><a href={site.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a><a href={`mailto:${site.email}`}>Email ↗</a></div>
      <span class="footer-year">© 2026</span>
    </footer>
  </div>
</BaseLayout>